# 실제 값은 .env 파일(git에 안 올라감)에 채워 넣는다. 이 파일은 어떤 값이 필요한지 보여주는 견본이다.
# 참고: docs/DETAIL_SPEC.md 7장 - 어느 출처를 실제로 쓸지는 아직 확정되지 않았다.

# 데이터베이스 접속 정보
# docker-compose.yml과 Django(config/settings.py)가 이 값을 함께 읽는다.
# DB_PASSWORD는 반드시 직접 만든 강한 값으로. 기본값("postgres")은 쓰지 않는다.
DB_NAME=aftertaste
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# 외부 공공데이터 API 키

# 영화진흥위원회(KOBIS) Open API
KOBIS_API_KEY=

# 경기 데이터 드림 Open API ("촬영지원 현황" 데이터셋)
GYEONGGI_DATA_DREAM_API_KEY=

# 한국문화정보원 API (미디어콘텐츠 영상 촬영지 데이터, CSV 파일로만 제공)
KCISA_API_KEY=

# 한국관광공사 TourAPI (국문 관광정보 서비스_GW)
# 등록된 관광지·음식점의 대표 이미지(firstimage)를 명소 photo_url에 채우는 데 쓴다
# (import_place_photos). 공공데이터포털의 "디코딩된 일반 인증키"를 넣는다.
TOUR_API_KEY=

# 카카오맵 지오코딩 REST API 키
# 좌표가 없는 출처(경기 데이터 드림)의 장소명을 좌표로 바꿔서, 좌표가 있는 다른 출처
# (한국문화정보원)와 같은 명소인지 100m 이내 여부로 비교하는 데 쓴다.
KAKAO_API_KEY=

# Google Cloud Translation API (v2) 키
# 명소·작품 이름·설명을 영어로 번역하는 데 쓴다 (docs/DETAIL_SPEC.md 4장 - 번역 규칙)
GOOGLE_TRANSLATE_API_KEY=

# 한국영상자료원 KMDB(한국영화데이터베이스) Open API
# 제목/감독/키워드로 영화를 검색해 작품(Work) 정보를 채운다 (docs/DETAIL_SPEC.md 6-1 #28)
KMDB_API_KEY=

# TMDB(The Movie Database) API 읽기 액세스 토큰(v4, "Bearer <토큰>" 헤더)
# 드라마 등 KMDB로 못 채운 작품의 줄거리·감독·방영일자·포스터를 보강한다 (docs/DETAIL_SPEC.md 6-1 #29)
TMDB_API_KEY=
# 아래 둘은 기본값이 있으니 특별히 바꿀 이유가 없으면 비워둬도 된다
TMDB_IMAGE_BASE_URL=
TMDB_POSTER_SIZE=
